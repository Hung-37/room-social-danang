# MySQL connection URI. Run database/schema.sql once before collecting.
MYSQL_URL=mysql://user:password@127.0.0.1:3306/room_social

# Production admin session. Use a long random secret; never expose these to the browser.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_NAME=System Admin
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
USER_SESSION_SECRET=replace-with-another-long-random-secret

# Listing freshness. Stale listings are hidden from the public feed.
LISTING_STALE_DAYS=30
LISTING_RETENTION_DAYS=90

# Local Ollama (never expose this key or endpoint to the browser).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Official Meta Graph API only. Use a server-side Page access token.
META_GRAPH_VERSION=v23.0
META_PAGE_ID=
META_ACCESS_TOKEN=

# Optional approved feeds. Leave empty until the provider permits integration.
# Use comma-separated URLs to load multiple approved feeds at once.
PUBLIC_FEED_URL=
PUBLIC_FEED_URLS=
PUBLIC_RSS_URL=
PUBLIC_RSS_URLS=
COLLECTOR_USE_AI=false
# Chỉ bật dữ liệu mẫu cho môi trường production khi thật sự cần kiểm thử.
COLLECTOR_INCLUDE_DEMO=false
CRON_SECRET=

# Optional custom HTML source. Built-in Da Nang sources are configured in js/collector.js.
# Only use additional sources when automated access and metadata reuse are permitted.
HTML_CRAWLER_URL=
# CSS selectors for HTML parsing (customize based on target website structure)
HTML_ITEM_SELECTOR=div.listing-item
HTML_TITLE_SELECTOR=h2.title
HTML_DESCRIPTION_SELECTOR=div.description
HTML_PRICE_SELECTOR=span.price
HTML_AREA_SELECTOR=span.area
HTML_ADDRESS_SELECTOR=div.address
