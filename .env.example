MYSQL_URL=mysql://room:change-me@127.0.0.1:3306/room_danang
ADMIN_EMAIL=admin@roomdanang.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Quản trị viên
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
USER_SESSION_SECRET=replace-with-another-random-secret-at-least-32-characters
LISTING_STALE_DAYS=30

# Shared MySQL pool limits per Node process
MYSQL_POOL_LIMIT=10
MYSQL_QUEUE_LIMIT=100
# Set a long random CRON_SECRET in hosting settings to allow authenticated scheduled collection.
# CRON_SECRET=
# Optional, for local development only; never enable demo collection on a public service.
COLLECTOR_INCLUDE_DEMO=false

# Optional public feeds; comma-separated URLs, enable only sources you may use.
# PUBLIC_FEED_URLS=
# PUBLIC_RSS_URLS=
# Custom HTML source; configure selectors for that source before enabling it.
# HTML_CRAWLER_URL=
# HTML_ITEM_SELECTOR=
# HTML_TITLE_SELECTOR=
# HTML_DESCRIPTION_SELECTOR=
# HTML_PRICE_SELECTOR=
# HTML_AREA_SELECTOR=
# HTML_ADDRESS_SELECTOR=

# Online MySQL TLS (Aiven): enable and provide the downloaded CA certificate.
# MYSQL_SSL=true
# MYSQL_SSL_CA_PATH=C:/certificates/aiven-ca.pem
# Alternatively set MYSQL_SSL_CA to the PEM certificate in hosting variables.
